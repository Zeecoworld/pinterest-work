# Copy this file to `.env` and fill in your real values.
# .env is git-ignored — never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-something-long-and-random
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# --- Supabase Postgres ---
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Transaction pooler" URL (port 6543) for most hosting platforms;
# use the direct connection (port 5432) if running migrations locally.
# Leave blank to fall back to local SQLite for quick local dev.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL_REQUIRE=true

# --- Supabase Storage (optional) ---
# Only needed if USE_SUPABASE_STORAGE=true. Get these from Project Settings
# → API. Use the service_role key (server-side only — never expose it
# client-side) so uploads work even on a private bucket.
USE_SUPABASE_STORAGE=false
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=pin-images

# --- AI image generation (optional, self-hosted & open-source) ---
# Point this at a running AUTOMATIC1111 Stable Diffusion WebUI instance
# (https://github.com/AUTOMATIC1111/stable-diffusion-webui), started with
# the --api flag — e.g. `./webui.sh --api --listen` on a GPU box, or
# `python launch.py --api` locally. Leave blank to use the local
# placeholder-image fallback instead (no GPU / server required).
SD_API_URL=
SD_NEGATIVE_PROMPT=text, watermark, logo, low quality, blurry, deformed, extra limbs, ugly
SD_STEPS=25
SD_CFG_SCALE=7
SD_TIMEOUT_SECONDS=120
